# Domínio canônico usado em metadata, sitemap e dados estruturados.
NEXT_PUBLIC_SITE_URL=https://santoscocorretora.com.br

# Verificação de propriedade para mecanismos de busca.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Integrações opcionais de marketing. Deixe em branco para não carregar.
# O site solicita consentimento antes de ativar essas ferramentas.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=

# E-mail que recebe os pedidos enviados pelo formulário.
# Para testes, está configurado com o e-mail do Rafael.
LEAD_DESTINATION_EMAIL=rspalmaetec@gmail.com

# Origens extras opcionais, separadas por vírgula.
# Localhost, Vercel e o domínio acessado são reconhecidos automaticamente.
LEAD_ALLOWED_ORIGINS=

# O formulário envia os dados pela rota /api/lead e pelo FormSubmit.
# NEXT_PUBLIC_LEAD_FORM_ENDPOINT não é necessário para o Vercel.

# Prova social do Google. Preencha apenas com dados reais e atuais.
NEXT_PUBLIC_GOOGLE_RATING=
NEXT_PUBLIC_GOOGLE_REVIEW_COUNT=
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=
